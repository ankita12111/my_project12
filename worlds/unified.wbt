WorldInfo {
  title "Multi-Task NAO Arena"
}
Viewpoint {
  orientation -0.057743102265977085 0.06504506017374145 0.9962102560642985 1.4558203620533994
  position -0.4330632065590776 -9.5 2.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 15 12
  wallThickness 2
  wallHeight 0.3
}

# ── NAO Robot ─────────────────────────────────────────────────────────────────
Nao {
  translation 0 0 0.334
  controller "unified_controller"
  supervisor TRUE
  rightHandSlot [
    DEF HAND_CONNECTOR Connector {
      name "right_hand_connector"
      type "symmetric"
      distanceTolerance 0.30
      axisTolerance 3.14
      rotationTolerance 3.14
      autoLock FALSE
    }
  ]
}

# ── Soccer Ball (kick task) ───────────────────────────────────────────────────
DEF SOCCER_BALL RobocupSoccerBall {
  translation 3 -1.5 0.0656167
  size 4
}

# ── Orange Box (grab/place task) ─────────────────────────────────────────────
DEF PICK_OBJECT Solid {
  translation 2.28062 1.79447 0.065
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.35 0
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.13 0.13 0.13
      }
    }
    Connector {
      name "object_connector"
      type "symmetric"
      distanceTolerance 0.30
      axisTolerance 3.14
      rotationTolerance 3.14
      autoLock FALSE
    }
  ]
  boundingObject Box {
    size 0.13 0.13 0.13
  }
  physics Physics {
    density 8
  }
}

